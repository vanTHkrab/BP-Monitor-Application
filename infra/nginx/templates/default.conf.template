# nginx reverse-proxy config for the BP Monitor prod stack.
#
# This file is a template, not a static config: the official `nginx` image's
# entrypoint (`/docker-entrypoint.d/20-envsubst-on-templates.sh`) runs
# `envsubst` over every `/etc/nginx/templates/*.template` file and writes the
# result to `/etc/nginx/conf.d/<name>` before nginx starts, substituting only
# variables that are actually set in the container's environment (see the
# `nginx` service's `environment:` block in docker-compose.prod.yml). nginx's
# own runtime variables (`$host`, `$remote_addr`, `$http_upgrade`, ...) are
# NOT environment variables, so they are left untouched by envsubst and work
# normally. Only `${DOMAIN_NAME}` below gets replaced.
#
# Topology (single domain, path-based routing — see infra/README.md for the
# subdomain-based alternative and why this was picked instead):
#   - https://${DOMAIN_NAME}/graphql   -> api-gateway:3000 (GraphQL + subscriptions)
#   - https://${DOMAIN_NAME}/graphiql  -> api-gateway:3000 (Mercurius GraphiQL UI)
#   - https://${DOMAIN_NAME}/          -> web:3000         (Next.js dashboard, catch-all)
#   - ai-service is never proxied here — it is reached by api-gateway only
#     over Redis pub/sub (analyze_bp_image / analyze_bp_image.reply) and by
#     web's server actions over the internal bp-net network directly
#     (http://ai-service:8000), neither of which needs a public route.
#
# Access model when this host is exposed to the public internet (see
# "Public demo access" in infra/README.md):
#   - /graphiql and / require HTTP Basic Auth (the shared demo key).
#   - /graphql does NOT, and must not — see the comment on that location.
#   - /.well-known/acme-challenge/ does NOT, and must not — gating it would
#     break Let's Encrypt renewal.

server_tokens off;

# Standard WebSocket-upgrade helper: Mercurius has `subscription: true`
# (server/app/api-gateway/src/app.module.ts), so /graphql must be able to
# upgrade to a WebSocket connection for graphql-ws, not just proxy plain
# HTTP request/response GraphQL operations.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# Per-IP rate limit for the public GraphQL endpoint. /graphql cannot be put
# behind the Basic Auth gate (the mobile client has no way to send a second
# credential — see the location block below), so it is the one surface an
# anonymous caller can reach. The app's own login throttle
# (server/app/api-gateway/src/redis/rate-limit.service.ts, configured per
# credential route in src/auth/better-auth.ts, 5 attempts / 15 min) is keyed
# by *phone number*, so it does not slow an attacker who rotates phones, and
# when Redis isn't ready it drops to a per-process counter — which means one
# budget per pod rather than one budget. This is the net-layer backstop for
# both cases.
#
# 10r/s with burst=40 is deliberately generous: a screen that fires several
# queries on focus must never trip it. It is a flood guard, not a quota.
limit_req_zone $binary_remote_addr zone=gql:10m rate=10r/s;

# Plain HTTP: always serve the ACME HTTP-01 challenge (needed for both
# initial issuance and every renewal), redirect everything else to HTTPS.
server {
    listen 80;
    listen [::]:80;
    server_name ${DOMAIN_NAME};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# HTTPS: sole public ingress for the dashboard and the GraphQL API.
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${DOMAIN_NAME};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN_NAME}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN_NAME}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;
    ssl_session_cache shared:le_ssl:10m;
    ssl_session_timeout 1d;
    add_header Strict-Transport-Security "max-age=63072000" always;

    # api-gateway's Fastify bodyLimit is 16 MiB (server/app/api-gateway/src/main.ts);
    # give a little headroom so nginx never clips a request the app would
    # otherwise accept.
    client_max_body_size 20m;

    # certbot renewal keeps hitting this path over plain HTTP (see the `80`
    # server block above); this copy only matters if something reaches the
    # HTTPS host directly, but costs nothing to keep in sync.
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    # GraphQL API — hit directly by the mobile client (client/constants/api.ts)
    # and by the web dashboard's server actions (web/src/lib/gateway.ts).
    # Kept on the same server block / domain as the dashboard rather than a
    # separate api.${DOMAIN_NAME} host: this is a greenfield deploy with one
    # DOMAIN_NAME and no DNS split yet, so one host + one cert is the simpler
    # bootstrap. Revisit if gateway and dashboard ever need independent
    # scaling / rate limiting / WAF policy.
    #
    # Deliberately NOT behind `auth_basic`, unlike /graphiql and / below.
    # The mobile client's transport (client/constants/api.ts) sends exactly
    # two headers — Content-Type and `Authorization: Bearer <jwt>` — with no
    # hook for a second static credential, and `Authorization` is already
    # taken by the JWT. Adding Basic Auth here would break every installed
    # app, not just anonymous callers. Access control for this route is the
    # gateway's own JWT auth + login throttle; `limit_req` below is the
    # net-layer flood guard. Do not "fix" the inconsistency with the two
    # gated locations by adding auth_basic here.
    location /graphql {
        limit_req zone=gql burst=40 nodelay;
        limit_req_status 429;

        proxy_pass http://api-gateway:3000/graphql;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        # Long-lived subscription connections shouldn't be cut by nginx's
        # default read/send timeouts.
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # Mercurius GraphiQL UI. Two independent gates, because either one alone
    # is insufficient:
    #   1. App-side: server/app/api-gateway/src/app.module.ts now resolves
    #      `graphiql` from GRAPHIQL_ENABLED, defaulting OFF when
    #      NODE_ENV=production. With it off the gateway 404s this path, so
    #      the UI is not merely hidden behind a proxy — it isn't served.
    #   2. Here: auth_basic, so that turning GRAPHIQL_ENABLED=1 for a demo
    #      doesn't hand an anonymous visitor a schema explorer with mutation
    #      access to a live database.
    location /graphiql {
        auth_basic           "BP Monitor demo";
        auth_basic_user_file /etc/nginx/auth/.htpasswd;

        proxy_pass http://api-gateway:3000/graphiql;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
    }

    # Next.js dashboard — catch-all.
    #
    # Behind auth_basic because the dashboard is team-internal and its login
    # form is credential-less by design (web/CLAUDE.md), while its server
    # actions connect *directly* to Postgres, Redis and S3 (web/src/lib/
    # db.ts, redis.ts, s3.ts). Un-gated on a public host, this route is a
    # read-anything database inspector. The Basic Auth key is the only thing
    # standing in front of it until the dashboard grows real auth.
    location / {
        auth_basic           "BP Monitor demo";
        auth_basic_user_file /etc/nginx/auth/.htpasswd;

        proxy_pass http://web:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
    }
}
