# PostgreSQL (development stack only — production Postgres is Supabase)
POSTGRES_USER=bpmonitor
POSTGRES_PASSWORD=change-me-in-real-env
POSTGRES_DB=bpmonitor

# API Gateway reads this — keep host = "postgres" (the service name) when running in compose
DATABASE_URL=postgresql://bpmonitor:change-me-in-real-env@postgres:5432/bpmonitor?schema=public

# Auth
JWT_SECRET=replace-with-a-long-random-string-min-32-chars
JWT_EXPIRES_IN=7d
# Forwarded to the gateway, which ignores it: BCRYPT_SALT_ROUNDS is the
# hard-coded constant 10 in src/auth/auth.config.ts. Kept so an existing .env
# does not break; changing it has no effect and does not invalidate hashes.
BCRYPT_SALT_ROUNDS=10

# Better Auth's public origin. **ORIGIN ONLY** — `/api/auth` is appended by
# Better Auth itself and any other path is discarded with a warning. Unset,
# every route under /api/auth 404s, which includes the mobile app's email-OTP
# verification (client/src/modules/auth/services/email-otp-api.ts calls
# POST /api/auth/email-otp/* directly). It costs nothing at boot.
BETTER_AUTH_URL=http://localhost:3000
# Falls back to JWT_SECRET when empty. Set it explicitly in any real
# environment so rotating one does not silently rotate the other.
BETTER_AUTH_SECRET=

# Passkeys and Google sign-in. All optional, and all ABSENT rather than broken
# when unset — which is also how they stay unset without anyone noticing.
# PASSKEY_RP_ID must be a bare registered domain: never an IP, port or scheme,
# so passkeys cannot work against a LAN dev address at all. It must be the same
# domain that serves /.well-known/assetlinks.json.
PASSKEY_RP_ID=
PASSKEY_RP_NAME=
ANDROID_APP_PACKAGE_NAME=
ANDROID_APP_SHA256_FINGERPRINT=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ANDROID_CLIENT_ID=
# Unset, Expo accepts a push send from anyone holding one of our push tokens.
EXPO_ACCESS_TOKEN=
HAVE_I_BEEN_PWNED_ENABLED=

# Email delivery (SMTP, via nodemailer — see docs/guides/email-delivery-setup.md)
# Unset SMTP_HOST logs the reset link / one-time code instead of sending, which
# is the development default. In production the gateway throws instead, so
# email verification and password reset are broken until this is filled in.
# Resend: smtp.resend.com / 587 / user is the literal string "resend" / an API
# key with Sending access. Mailpit in the dev stack: mailpit / 1025 / no auth.
# 587 or 465 only — outbound 25 is blocked at the cloud-provider level.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# The From header. Its domain must be verified with the provider or every send
# is rejected. Format: "BP Monitor <no-reply@yourdomain.com>".
MAIL_FROM=

# Web dashboard (development stack only — `web` is not deployed to production;
# it is defined in docker-compose.dev.yml and nowhere else). Declared on the
# service but nothing under web/src/ reads it: the dashboard talks to the
# gateway server-side via GATEWAY_URL, which Compose sets to the service name.
NEXT_PUBLIC_API_URL=http://localhost:3000/graphql

# ── Ingress: Cloudflare Tunnel (prod-shaped stack — docker-compose.prod.yml) ─
# The hostname clients use. nginx uses it only for `server_name`, and the block
# is `default_server` so a mismatch does not 404. What actually routes traffic
# is the Public Hostname row in the Cloudflare dashboard:
#   Zero Trust -> Networks -> Tunnels -> <tunnel> -> Public Hostname
#   api.example.com  ->  HTTP://nginx:80
# No DNS A record and no inbound port are needed; the connector dials out.
DOMAIN_NAME=api.example.com
# The tunnel's credential — enough on its own to publish traffic into this
# network. In the real deploy it is a Podman secret, never an env file. Leave
# it EMPTY when rehearsing locally: a real token would publish your laptop on a
# real hostname. Exercise nginx from inside the network instead:
#   docker compose exec nginx wget -qO- 'http://127.0.0.1/graphql?query=%7Bhello%7D'
TUNNEL_TOKEN=

# Mercurius GraphiQL UI (prod-shaped stack only — it is always on outside
# production). Leave 0 on any internet-facing host: GraphiQL is a schema
# explorer with full mutation access to the live database. Set to 1 (or
# true/yes/on — any other value, recognised or not, leaves it off) only for a
# demo; nginx additionally keeps /graphiql behind the Basic Auth gate either
# way. See infra/README.md "Public demo access".
GRAPHIQL_ENABLED=0

# AI service — public R2 base URL hosting the OCR model artifacts
# (yolo11n.onnx, crnn.onnx, cnn_2ch_distilled_*_int8.onnx, templates.npz).
# docker-entrypoint.sh refuses to start if this is the placeholder value.
AI_MODELS_R2_BASE_URL=https://REPLACE_ME.r2.dev/bp-monitor/models

# S3-compatible storage (consumed by api-gateway's StorageModule, and by the
# dev dashboard's own S3 client)
# Production target is Cloudflare R2. For staging on EC2 we point at
# Supabase Cloud Storage's S3 protocol endpoint — same env shape, no
# code change needed. Generate the access keys under
# Supabase dashboard → Project Settings → Storage → S3 Connection.
# These are NOT the anon / service_role JWT keys.
#
# Staging (Supabase Cloud) example:
#   S3_PROVIDER=supabase
#   S3_ENDPOINT=https://<project-ref>.supabase.co/storage/v1/s3
#   S3_BUCKET_NAME=bp-monitor-staging
#   S3_DEFAULT_REGION=ap-southeast-1
#   S3_USE_PATH_STYLE_ENDPOINT=true
#   S3_PUBLIC_BASE_URL=https://<project-ref>.supabase.co/storage/v1/object/public/bp-monitor-staging
#
# Production (Cloudflare R2) example:
#   S3_PROVIDER=r2
#   S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
#   S3_BUCKET_NAME=bp-monitor
#   S3_DEFAULT_REGION=auto
#   S3_USE_PATH_STYLE_ENDPOINT=true
#   S3_PUBLIC_BASE_URL=https://cdn.example.com
S3_PROVIDER=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_DEFAULT_REGION=
S3_BUCKET_NAME=
S3_ENDPOINT=
S3_USE_PATH_STYLE_ENDPOINT=
S3_PUBLIC_BASE_URL=

# ── Removed ─────────────────────────────────────────────────────────────────
# CERTBOT_EMAIL / CERTBOT_STAGING — TLS terminates at Cloudflare's edge now.
# There is no certbot service, no ACME challenge, and no port 443 in any of
# these stacks. infra/scripts/init-letsencrypt.sh is gone with them.
