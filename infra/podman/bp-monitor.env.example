# BP Monitor — Podman/EC2 production runtime, NON-SECRET configuration.
#
# Copy to /etc/bp-monitor/bp-monitor.env on the host and fill in. This file is
# an example only; never commit a filled-in copy.
#
#   sudo install -d -m 0755 -o "$USER" -g "$USER" /etc/bp-monitor
#   install -m 0640 infra/podman/bp-monitor.env.example /etc/bp-monitor/bp-monitor.env
#
# ── What is NOT in this file, on purpose ────────────────────────────────────
# Six values are injected as Podman secrets instead, because they are
# credentials rather than configuration:
#
#   bp-database-url          -> DATABASE_URL for api-gateway
#                               Supabase TRANSACTION pooler, port 6543
#   bp-database-url-direct   -> DATABASE_URL for bp-migrate.service ONLY
#                               direct or SESSION pooler, port 5432
#   bp-jwt-secret            -> JWT_SECRET
#   bp-s3-access-key-id      -> S3_ACCESS_KEY_ID
#   bp-s3-secret-access-key  -> S3_SECRET_ACCESS_KEY
#   bp-tunnel-token          -> TUNNEL_TOKEN for cloudflared
#
# Create them once per host — see infra/podman/README.md, "Secrets". They are
# stored under the deploy user's Podman store at mode 0600 and are mounted into
# the container process environment, never written to a layer or a bind mount.
#
# Everything below is not a credential. It still deserves 0640 and an owner of
# the deploy user, because DOMAIN_NAME and the S3 endpoint are useful
# reconnaissance.

# ── Image tag ───────────────────────────────────────────────────────────────
# The tag scripts/build-images.sh produced, normally a git short SHA. Used by
# bp-migrate.service so the migration runs from the same build as the deploy.
# The .container units reference :latest, which build-images.sh also moves.
# Record this value in your deploy notes: it is the rollback target.
BP_IMAGE_TAG=latest

# ── Ingress: Cloudflare Tunnel ──────────────────────────────────────────────
# The hostname clients use. This is an API host, not a website: the mobile app
# calls https://$DOMAIN_NAME/graphql, and Better Auth's own routes live under
# https://$DOMAIN_NAME/api/auth/*.
#
# Unlike the previous nginx+certbot runtime, this needs NO DNS A record and NO
# inbound port. Cloudflare creates a CNAME to the tunnel when you add the
# Public Hostname, and the connector dials out. The instance's inbound security
# group should be empty.
#
# nginx uses this only for `server_name`; the block is `default_server`, so a
# mismatch does not 404. What actually routes traffic is the Public Hostname
# row in the Cloudflare dashboard:
#
#   Zero Trust -> Networks -> Tunnels -> <tunnel> -> Public Hostname
#   api.example.com  ->  HTTP://nginx:80
#
# Nothing in this repo can verify that row. Keep this value in step with it by
# hand — if they disagree, every container is healthy and the site is down.
DOMAIN_NAME=api.example.com

# ── api-gateway ─────────────────────────────────────────────────────────────
# Mercurius GraphiQL. Leave 0 on an internet-facing host: it is a schema
# explorer with mutation access to live patient data. 1/true/yes/on turn it on;
# any other value, recognised or not, leaves it off. nginx additionally keeps
# /graphiql behind Basic Auth either way.
GRAPHIQL_ENABLED=0
JWT_EXPIRES_IN=7d

# Better Auth's public origin. **ORIGIN ONLY** — `/api/auth` is appended by
# Better Auth itself and any other path is discarded with a warning. Must be
# https and must match DOMAIN_NAME, because that is what the client resolves.
#
# Getting this wrong costs nothing at boot and 404s every auth route
# afterwards, including the mobile app's email-OTP verification, which calls
# POST /api/auth/email-otp/* directly.
BETTER_AUTH_URL=https://api.example.com

# ── Passkeys and Google sign-in ─────────────────────────────────────────────
# Every value here is optional at boot and the feature is ABSENT rather than
# broken when it is missing — the gateway does not load the passkey plugin
# without an RP ID, and the mobile app hides both buttons instead of showing
# them failing. That is good behaviour and it is also how these stay unset for
# months without anyone noticing.
#
# A bare registered domain. Never an IP, a port, or a scheme — the gateway
# throws at boot on those.
#
# ⚠️ The RP ID and the host serving /.well-known/assetlinks.json must be the
# SAME domain. This stack serves assetlinks.json from the gateway at
# https://$DOMAIN_NAME/.well-known/assetlinks.json, so with DOMAIN_NAME =
# api.example.com the RP ID must be api.example.com too. Setting it to the bare
# example.com means Android fetches assetlinks.json from example.com — which
# this stack does not serve — and rejects the passkey with no useful message.
PASSKEY_RP_ID=
# Shown on the system passkey sheet. Defaults to "BP Monitor".
PASSKEY_RP_NAME=
# Must match expo.android.package in client/app.json. Defaults to
# com.project.bpmobile.
ANDROID_APP_PACKAGE_NAME=
# From `keytool -list -v -keystore <path> -alias <alias>` — 32 colon-separated
# hex bytes. Comma-separate the debug, release and Play App Signing keys; a
# passkey works only on builds whose key is listed.
ANDROID_APP_SHA256_FINGERPRINT=
# The **web** OAuth credentials. Google sign-in stays unregistered until both
# are set, so it reads as "not set up here" rather than breaking at the
# redirect.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# The **Android** OAuth client, added as a second accepted *audience* — not a
# second provider. Without it every mobile Google sign-in fails as an invalid
# token while the web flow keeps working, which reads like a broken app build.
GOOGLE_ANDROID_CLIENT_ID=

# ── Push notifications ──────────────────────────────────────────────────────
# Expo access token (expo.dev -> Account -> Access tokens). Unset, Expo accepts
# a push send from anyone holding one of our push tokens; set, only requests
# carrying this token are honoured. Push works either way and nothing fails at
# boot — set it here precisely because the failure is invisible.
EXPO_ACCESS_TOKEN=

# ── Optional hardening ──────────────────────────────────────────────────────
# `true` rejects passwords found in known breaches. Adds an outbound call to
# the sign-up path.
HAVE_I_BEEN_PWNED_ENABLED=

# ── ai-service ──────────────────────────────────────────────────────────────
# Public R2 base URL the entrypoint downloads model artifacts from
# (yolo11n.onnx, crnn.onnx, cnn_2ch_distilled_*_int8.onnx, templates.npz).
# The container refuses to start while this is the placeholder. Needs outbound
# HTTPS from the instance.
AI_MODELS_R2_BASE_URL=https://REPLACE_ME.r2.dev/bp-monitor/models

# ── S3-compatible object storage ────────────────────────────────────────────
# Bytes for BP images and profile photos. The key and secret are Podman secrets
# (above); these are the non-secret half.
#
# Production target is Cloudflare R2:
#   S3_PROVIDER=r2
#   S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
#   S3_BUCKET_NAME=bp-monitor
#   S3_DEFAULT_REGION=auto
#   S3_USE_PATH_STYLE_ENDPOINT=true
#   S3_PUBLIC_BASE_URL=https://cdn.example.com
#
# Supabase Cloud Storage's S3 endpoint works with the same env shape if you are
# consolidating on Supabase:
#   S3_PROVIDER=supabase
#   S3_ENDPOINT=https://<project-ref>.supabase.co/storage/v1/s3
#   S3_DEFAULT_REGION=ap-southeast-1
#   S3_USE_PATH_STYLE_ENDPOINT=true
# Its access keys come from Project Settings -> Storage -> S3 Connection. They
# are NOT the anon / service_role JWT keys.
S3_PROVIDER=
S3_ENDPOINT=
S3_BUCKET_NAME=
S3_DEFAULT_REGION=
S3_USE_PATH_STYLE_ENDPOINT=
S3_PUBLIC_BASE_URL=

# ── Removed from this runtime ───────────────────────────────────────────────
# CERTBOT_EMAIL / CERTBOT_STAGING — TLS terminates at Cloudflare's edge. There
#   is no certbot container, no ACME challenge, and no port 80 to validate on.
# NEXT_PUBLIC_API_URL — the `web` dashboard is no longer deployed. It runs
#   locally against the datastores; see infra/README.md.
# BCRYPT_SALT_ROUNDS — was always inert. The gateway uses the hard-coded
#   constant 10 in src/auth/auth.config.ts and never read this variable.
