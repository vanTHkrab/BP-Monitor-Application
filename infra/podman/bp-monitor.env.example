# BP Monitor — Podman/EC2 production runtime, NON-SECRET configuration.
#
# Copy to /etc/bp-monitor/bp-monitor.env on the host and fill in. This file is
# an example only; never commit a filled-in copy.
#
#   sudo install -d -m 0755 -o "$USER" -g "$USER" /etc/bp-monitor
#   install -m 0640 infra/podman/bp-monitor.env.example /etc/bp-monitor/bp-monitor.env
#
# ── What is NOT in this file, on purpose ────────────────────────────────────
# Five values are injected as Podman secrets instead, because they are
# credentials rather than configuration and one of them now travels to a third
# party (Supabase):
#
#   bp-database-url          -> DATABASE_URL for api-gateway and web
#                               Supabase TRANSACTION pooler, port 6543
#   bp-database-url-direct   -> DATABASE_URL for bp-migrate.service ONLY
#                               direct or SESSION pooler, port 5432
#   bp-jwt-secret            -> JWT_SECRET
#   bp-s3-access-key-id      -> S3_ACCESS_KEY_ID
#   bp-s3-secret-access-key  -> S3_SECRET_ACCESS_KEY
#
# Create them once per host — see infra/podman/README.md, "Secrets". They are
# stored under the deploy user's Podman store at mode 0600 and are mounted into
# the container process environment, never written to a layer or a bind mount.
#
# Everything below is not a credential. It still deserves 0640 and an owner of
# the deploy user, because DOMAIN_NAME and the S3 endpoint are useful
# reconnaissance.

# ── Image tag ───────────────────────────────────────────────────────────────
# The tag scripts/build-images.sh produced, normally a git short SHA. Used by
# bp-migrate.service so the migration runs from the same build as the deploy.
# The .container units reference :latest, which build-images.sh also moves.
# Record this value in your deploy notes: it is the rollback target.
BP_IMAGE_TAG=latest

# ── nginx / certbot ─────────────────────────────────────────────────────────
# Domain nginx terminates TLS for and certbot issues against. Needs an A record
# (and AAAA if the host has IPv6) pointing at this EC2 instance's public or
# Elastic IP BEFORE first issuance — Let's Encrypt validates by making an
# inbound HTTP request to it on port 80.
DOMAIN_NAME=example.com
# Where Let's Encrypt sends expiry and problem notices.
CERTBOT_EMAIL=admin@example.com
# 1 requests from the staging CA: untrusted by browsers, exempt from the
# production rate limit. Use it for the first run on a new domain, confirm the
# flow, then re-run with 0.
CERTBOT_STAGING=0

# ── api-gateway ─────────────────────────────────────────────────────────────
# Mercurius GraphiQL. Leave 0 on an internet-facing host: it is a schema
# explorer with mutation access to live patient data. 1/true/yes/on turn it on;
# any other value, recognised or not, leaves it off. nginx additionally keeps
# /graphiql behind Basic Auth either way.
GRAPHIQL_ENABLED=0
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# ── web ─────────────────────────────────────────────────────────────────────
# Inlined into the browser bundle at `next build` time, so setting it here has
# no effect on already-built client code. Kept for parity with the Compose
# stack. See the note in quadlet/bp-web.container.
NEXT_PUBLIC_API_URL=https://example.com/graphql

# ── ai-service ──────────────────────────────────────────────────────────────
# Public R2 base URL the entrypoint downloads model artifacts from
# (yolo11n.onnx, crnn.onnx, cnn_2ch_distilled_*_int8.onnx, templates.npz).
# The container refuses to start while this is the placeholder. Needs outbound
# HTTPS from the instance.
AI_MODELS_R2_BASE_URL=https://REPLACE_ME.r2.dev/bp-monitor/models

# ── S3-compatible object storage ────────────────────────────────────────────
# Bytes for BP images and profile photos. The key and secret are Podman secrets
# (above); these are the non-secret half.
#
# Production target is Cloudflare R2:
#   S3_PROVIDER=r2
#   S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
#   S3_BUCKET_NAME=bp-monitor
#   S3_DEFAULT_REGION=auto
#   S3_USE_PATH_STYLE_ENDPOINT=true
#   S3_PUBLIC_BASE_URL=https://cdn.example.com
#
# Supabase Cloud Storage's S3 endpoint works with the same env shape if you are
# consolidating on Supabase:
#   S3_PROVIDER=supabase
#   S3_ENDPOINT=https://<project-ref>.supabase.co/storage/v1/s3
#   S3_DEFAULT_REGION=ap-southeast-1
#   S3_USE_PATH_STYLE_ENDPOINT=true
# Its access keys come from Project Settings -> Storage -> S3 Connection. They
# are NOT the anon / service_role JWT keys.
S3_PROVIDER=
S3_ENDPOINT=
S3_BUCKET_NAME=
S3_DEFAULT_REGION=
S3_USE_PATH_STYLE_ENDPOINT=
S3_PUBLIC_BASE_URL=
