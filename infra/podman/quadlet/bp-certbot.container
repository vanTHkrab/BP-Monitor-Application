# certbot — Let's Encrypt renewal loop.
#
# Long-running rather than a systemd timer, reusing infra/certbot/renew-loop.sh
# unchanged from the Compose stack (`certbot renew` every 12h; a no-op for any
# certificate outside its renewal window).
#
# A systemd .timer would be the more idiomatic choice on a systemd-managed host
# and would drop this container to zero resident cost between runs. It was not
# taken here for one reason: the renew loop and the nginx reload loop are a
# matched pair whose timing relationship (12h renew / 6h reload) is documented
# and reviewed in the Compose stack. Splitting one half onto a timer while the
# other stays an in-container loop makes that pairing harder to reason about for
# no operational gain on a single host. Reconsider if this ever becomes a
# multi-host deploy. Noted as a follow-up in the report.
#
# Does NOT perform first issuance — nginx cannot start without a certificate to
# point ssl_certificate at, so the very first one has to be obtained
# out-of-band. Run scripts/init-letsencrypt.sh once per fresh host.
#
# The image tag is deliberately `latest` while this project pins its own images.
# certbot has to track Let's Encrypt's ACME protocol over however many years
# this host stays up, and a stale pin is a known way for renewals to start
# failing silently. Bump it by hand as routine maintenance:
#   podman pull docker.io/certbot/certbot:latest && systemctl --user restart bp-certbot

[Unit]
Description=BP Monitor — certbot renewal loop
PartOf=bp-monitor.target
After=bp-nginx.service

[Container]
ContainerName=certbot
Image=docker.io/certbot/certbot:latest
Network=bp-net.network

Volume=bp-certbot-certs.volume:/etc/letsencrypt
Volume=bp-certbot-www.volume:/var/www/certbot
Volume=/opt/bp-monitor/infra/certbot/renew-loop.sh:/usr/local/bin/renew-loop.sh:ro,z

Entrypoint=/bin/sh
Exec=/usr/local/bin/renew-loop.sh

NoNewPrivileges=true
PodmanArgs=--memory=256m --memory-swap=256m --cpus=0.25

[Service]
Restart=always
RestartSec=60

[Install]
WantedBy=bp-monitor.target
