# nginx — the /graphiql Basic Auth gate, the per-IP flood guard on /graphql,
# and the routing table that puts /api/auth/* and /.well-known/assetlinks.json
# on the gateway.
#
# It is no longer the *public* ingress and no longer terminates TLS. Traffic
# arrives from the `cloudflared` container over bp-net; Cloudflare's edge
# terminates TLS and the tunnel hop is an outbound encrypted connection. See
# quadlet/bp-cloudflared.container and infra/podman/README.md.
#
# Reuses infra/nginx/templates/default.conf.template, infra/nginx/reload-loop.sh
# and infra/nginx/auth/.htpasswd. That reuse is the point: the access model
# those files encode (what is gated, what must not be, and why) is a security
# decision that was already made and reviewed. Moving TLS to Cloudflare changed
# where the connection is encrypted, not what this server is willing to serve.
#
# ── No PublishPort, and that is the whole security win ──────────────────────
# This container binds nothing on the host. The EC2 instance can — and should —
# have an empty inbound security group. That also retires the host sysctl
# `net.ipv4.ip_unprivileged_port_start=80` that rootless :80/:443 used to
# require; scripts/install.sh no longer sets it.
#
# ── Host paths, not bind mounts of a repo checkout ──────────────────────────
# The mounts below assume the repo is checked out at /opt/bp-monitor on the
# host. `:ro` on all of them, and `:z` for SELinux relabelling — Amazon Linux
# 2023 and RHEL-family hosts run SELinux enforcing and a mount without :z or :Z
# fails with a permission error that reads like a file-not-found. Drop the :z
# only if you know the host has SELinux disabled.
#
# ── The operational trap worth knowing ──────────────────────────────────────
# nginx resolves `proxy_pass http://api-gateway:3000` ONCE, at config load. If
# api-gateway is recreated and lands on a different address on bp-net, nginx
# keeps proxying to the stale one and every request 502s. The 6h reload loop
# re-reads the config and re-resolves, so this self-heals within 6h; to fix it
# immediately after a gateway redeploy, run
#   systemctl --user restart bp-nginx
# The deploy script does this for you.
#
# The second trap — nginx refusing to start without a certificate file — is
# gone with certbot. This unit now starts on a bare host with no bootstrap step.

[Unit]
Description=BP Monitor — nginx router and access gate
PartOf=bp-monitor.target
Requires=bp-api-gateway.service
After=bp-api-gateway.service

[Container]
ContainerName=nginx
Image=docker.io/library/nginx:1.27-alpine
Network=bp-net.network

EnvironmentFile=/etc/bp-monitor/bp-monitor.env

Volume=/opt/bp-monitor/infra/nginx/templates:/etc/nginx/templates:ro,z
Volume=/opt/bp-monitor/infra/nginx/auth:/etc/nginx/auth:ro,z
# /docker-entrypoint.d/, NOT /usr/local/bin, and there is deliberately no
# `Exec=` below. The image's entrypoint renders /etc/nginx/templates/*.template
# through envsubst only when the command it receives starts with `nginx`.
# Setting Exec=/bin/sh ... skipped that entirely: nginx booted on the stock
# default.conf, the domain served "Welcome to nginx!", and /graphql 404'd while
# systemd reported the unit active. Leaving Exec unset runs the image's default
# command, which is what makes the template render at all.
#
# The mounted file must keep its executable bit — the entrypoint logs
# "Ignoring ..., not executable" and skips it otherwise, which costs the 6h
# reload with no other symptom.
Volume=/opt/bp-monitor/infra/nginx/reload-loop.sh:/docker-entrypoint.d/99-reload-loop.sh:ro,z

# Now that this server is plain HTTP on an internal network, a loopback probe
# is finally meaningful — the old unit had no HealthCmd because every candidate
# either followed a 301 to :443 or required the container to trust its own
# public certificate chain for a name it reaches by public DNS.
#
# This probes the `hello` query THROUGH the proxy, so a pass proves both that
# nginx is serving and that it still resolves api-gateway on bp-net — which is
# exactly the stale-upstream failure described above. A root-path probe would
# not: the gateway 404s `/`, and wget exits non-zero on a 404.
#
# UNVERIFIED, same caveat as bp-api-gateway.container: Mercurius serving
# GraphQL over GET has not been exercised against a running gateway. Confirm on
# the host with
#   podman exec nginx wget -q -O - 'http://127.0.0.1:80/graphql?query=%7Bhello%7D'
# and drop this line if it does not hold. A wrong healthcheck here is cosmetic:
# no HealthOnFailure action is set, so "unhealthy" reports and does not restart.
HealthCmd=wget -q -O /dev/null -T 3 http://127.0.0.1:80/graphql?query=%7Bhello%7D
HealthInterval=30s
HealthTimeout=5s
HealthRetries=3
HealthStartPeriod=15s

NoNewPrivileges=true
PodmanArgs=--memory=256m --memory-swap=256m --cpus=0.5

[Service]
Restart=always
RestartSec=10

[Install]
WantedBy=bp-monitor.target
