# Let's Encrypt state: /etc/letsencrypt (live certs, archive, renewal conf).
#
# Shared read-write with the certbot container and read-only with nginx.
# Losing this volume means re-running scripts/init-letsencrypt.sh and burning
# another issuance against Let's Encrypt's per-domain rate limit — back it up
# or accept the re-issue, but know which you chose.

[Unit]
Description=BP Monitor Let's Encrypt certificate volume

[Volume]
VolumeName=bp-certbot-certs
Label=app=bp-monitor
