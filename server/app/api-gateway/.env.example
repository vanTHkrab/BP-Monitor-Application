# Connect to Database via connection pooling
DATABASE_URL=

# App server
PORT=3000
# Keep this line. This project's own `isProduction()` treats unset as
# development, but Better Auth's rate limiter compares the value strictly: it
# substitutes a localhost IP only for exactly `development` or `dev`. Unset,
# no client address resolves locally, every caller shares one rate-limit
# bucket per path, and the only signal is one warning at startup.
NODE_ENV=development
# Set to 1, true, yes, or on (case-insensitive) to force GraphiQL on in
# production. Any other non-empty value forces it OFF, including unrecognised
# ones — the accepted set is closed so a typo cannot open a mutation-capable
# schema explorer. Unset or empty (as below) defaults to "on in development,
# off in production".
GRAPHIQL_ENABLED=

# S3 Configuration for file storage
S3_PROVIDER=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_DEFAULT_REGION=
S3_BUCKET_NAME=
S3_ENDPOINT=
S3_USE_PATH_STYLE_ENDPOINT=
# Public base URL used to build readable object URLs; falls back to
# S3_ENDPOINT-derived host when unset.
S3_PUBLIC_BASE_URL=

# Falls back to JWT_SECRET when unset — set explicitly in production so
# rotating one does not silently rotate the other.
JWT_SECRET=
JWT_EXPIRES_IN=

# Redis — pub/sub transport to ai-service AND the rate-limit store.
# Set REDIS_URL for a managed instance (it is the only form that can carry a
# password or TLS); the host/port pair is the local default. All three of the
# gateway's Redis clients resolve through src/redis/redis-connection.ts, so
# these are read in exactly one place.
# REDIS_URL=rediss://default:password@host:6379
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=

# Better Auth
# Origin only — "/api/auth" is appended automatically and any other path
# is ignored with a warning. Required in production; defaults to
# http://localhost:$PORT in development.
BETTER_AUTH_URL=
# Falls back to JWT_SECRET when unset.
BETTER_AUTH_SECRET=
# Optional — if set, the gateway will check passwords against the
# Have I Been Pwned database and reject compromised passwords.
HAVE_I_BEEN_PWNED_ENABLED=

# Google OAuth (optional — Google sign-in stays unregistered until both
# are set, so it fails as "not set up" instead of at the redirect)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# The Android OAuth client ID, for on-device Google sign-in ("One Tap").
# It is a second accepted *audience*, not a second provider: Credential
# Manager returns an ID token minted for this client, and without it here
# every mobile Google sign-in fails as an invalid token while the web flow
# keeps working. The web client ID above stays first — it is the one used
# in the browser redirect.
GOOGLE_ANDROID_CLIENT_ID=

# Passkeys (optional — the plugin is not loaded at all when RP ID is unset,
# and the mobile app hides its passkey section in response)
#
# A bare registered domain. Never an IP, a port, or a scheme: those cannot
# be a WebAuthn relying party, which is why passkeys cannot work against a
# LAN dev address no matter how the app is configured.
PASSKEY_RP_ID=
# Shown by the system sheet when registering. Defaults to "BP Monitor".
PASSKEY_RP_NAME=

# Android app identity, used for two things: serving
# /.well-known/assetlinks.json, and deriving the "android:apk-key-hash:..."
# origin that Android actually presents during a passkey ceremony (it does
# NOT send https://<domain>).
#
# Get the fingerprint with:
#   keytool -list -v -keystore <path> -alias <alias> | grep SHA256
#
# Comma-separate several: debug builds, release builds, and Play App
# Signing are three different keys, and a passkey works only on the builds
# whose key is listed.
ANDROID_APP_SHA256_FINGERPRINT=
ANDROID_APP_PACKAGE_NAME=com.project.bpmobile

# Email delivery (SMTP, via nodemailer — see docs/guides/email-delivery-setup.md)
#
# Unset SMTP_HOST is the development default: the gateway logs the reset link
# or one-time code to the console instead of sending, so a fresh checkout
# works. In production it REFUSES the send and throws — a password-reset code
# dropped silently is worse than a request that fails loudly.
#
# Resend's values are SMTP_HOST=smtp.resend.com, SMTP_PORT=587,
# SMTP_USER=resend (the literal string, not an email address) and an API key
# with Sending access as the password. Local Mailpit is SMTP_HOST=mailpit,
# SMTP_PORT=1025 and no credentials at all.
#
# 587 (STARTTLS) or 465 (implicit TLS) only. Outbound 25 is blocked at the
# cloud-provider level and no container setting can work around it.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# The From header. Its domain must be one the provider has verified, or every
# send is rejected. Format: "BP Monitor <no-reply@yourdomain.com>".
MAIL_FROM=

# Expo push notifications (optional — push works without it)
#
# Without a token, Expo accepts a send from anyone holding one of our push
# tokens; with one, only requests carrying it are honoured. Left unset in
# development so a fresh checkout can send; set it in production.
# Create at https://expo.dev/ → Account → Access tokens.
EXPO_ACCESS_TOKEN=