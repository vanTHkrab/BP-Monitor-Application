{
  "extends": "./tsconfig.json",
  // `prisma.config.ts` is excluded, and that is load-bearing rather than tidy.
  // tsconfig.json sets no `rootDir`, so tsc infers the common root of every
  // included file. With a file at the project root in the build, that root is
  // the project, and the emit becomes dist/src/main.js + dist/prisma.config.js
  // — while package.json's `start:prod` runs `node dist/main`. The container
  // then exits with MODULE_NOT_FOUND on /app/dist/main, and `nest build`
  // reports success, because nothing about the layout is an error.
  //
  // Excluding it puts the common root back at src/, so the emit is
  // dist/main.js and `start:prod` resolves. Nothing needs the compiled copy:
  // Prisma 7 reads prisma.config.ts directly through its own TS loader, from
  // the project root, which is present in the image.
  "exclude": ["node_modules", "test", "dist", "**/*spec.ts", "prisma.config.ts"]
}
