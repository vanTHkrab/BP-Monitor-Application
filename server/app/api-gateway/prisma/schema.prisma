// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider     = "prisma-client"
  moduleFormat = "cjs"
  output       = "../src/prisma/generated"
}

datasource db {
  provider = "postgresql"
}

// ──────────────────────── Enums ────────────────────────

enum UserRole {
  caregiver
  developer
  patient
}

enum Gender {
  male
  female
  other
}

enum AlertLevel {
  warning
  critical
}

enum CaregiverLinkStatus {
  pending
  accepted
  rejected
}

/// What an accepted caregiver link permits.
///
/// Added before any feature needed it, on purpose. Every caregiver feature so
/// far assumes "accepted" means "may do everything" — read the history, record
/// on the patient's behalf, export a report under their name. Introducing the
/// distinction later means revisiting each of those; introducing it now is one
/// column and one default.
///
/// `full` is the default so existing rows keep exactly the behaviour they have
/// today. Nothing is taken away by this migration.
enum CaregiverPermission {
  /// Read the patient's readings and alerts. Cannot write anything.
  view
  /// Everything `view` allows, plus recording readings on the patient's behalf
  /// and editing the patient's health information (date of birth, gender,
  /// weight, height, congenital disease).
  ///
  /// The health-editing half was added after `full` already existed, so
  /// patients who granted it earlier were widened retroactively. What makes
  /// that defensible is that the grant is revocable at any time through
  /// `updateCaregiverPermission`, and that every edit made this way is
  /// recorded in `ProfileChangeLog` where the patient can read it. Both of
  /// those are load-bearing: remove either and this enum is a consent the
  /// patient never gave and cannot audit.
  ///
  /// Login identity is deliberately NOT included. `email` and `phone` are
  /// both `@unique` and both Better Auth sign-in identifiers, so a caregiver
  /// who could change one could request a password reset and take the
  /// account. They are unreachable through the caregiver edit path by
  /// construction — it has its own input type rather than sharing
  /// `UpdateProfileInput`.
  full
}

enum BpStatus {
  low
  normal
  elevated
  high
  critical
}

enum PostCategory {
  general
  experience
  qa
}

enum RelationshipType {
  parent
  patient
  caregiver
  child
  spouse
  sibling
  friend
  caregiver_professional
  other
}

// ──────────────────────── Models ────────────────────────

model User {
  id String @id @default(uuid()) @db.Uuid

  // ── Better Auth core identity ──
  // `email` is required by Better Auth and is the ownership proof account
  // linking depends on, so it is no longer nullable. `name` exists because
  // Better Auth requires a single display name and a field can only map to
  // one column — firstname/lastname stay as the domain fields.
  email         String  @unique @db.VarChar(255)
  emailVerified Boolean @default(false) @map("email_verified")
  name          String  @db.VarChar(201)

  firstname String @db.VarChar(100)
  lastname  String @db.VarChar(100)

  // Mapped to Better Auth's `phoneNumber` field. Stays NOT NULL: caregivers
  // find patients by phone, so an account without one is unreachable.
  phone               String  @unique @db.VarChar(30)
  phoneNumberVerified Boolean @default(false) @map("phone_number_verified")

  /// Legacy bcrypt hash, retained only until the credential backfill is
  /// verified against real sign-ins, then dropped.
  ///
  /// Nullable because Better Auth never writes it: credentials live on
  /// `accounts.password` (providerId = 'credential'), so every account
  /// created from now on has no legacy hash at all.
  passwordHash String?  @map("password_hash") @db.VarChar(255)
  role         UserRole @default(patient)

  /// When the user picked their own role in onboarding.
  ///
  /// Needed because `role` defaults to `patient`, so the column alone cannot
  /// tell "chose patient" from "never chose" — and the app has to know which,
  /// or someone who force-quits mid-onboarding is either asked forever or
  /// never asked at all. Null means the onboarding role step is still due.
  ///
  /// Not set by an admin using `/admin/set-role`: that is a grant, not a
  /// choice, and it should not silently satisfy the user's own step.
  roleSelectedAt DateTime? @map("role_selected_at")

  /// Which method the user last signed in with — 'email', 'phone-number',
  /// 'google', or 'passkey'. Written by Better Auth's `lastLoginMethod`
  /// plugin (`storeInDatabase: true`).
  ///
  /// Stored server-side rather than read from the plugin's cookie: the
  /// mobile client authenticates with a bearer token and never sends
  /// cookies, so the cookie the plugin sets by default is invisible to it.
  lastLoginMethod String? @map("last_login_method") @db.VarChar(32)

  // ── Better Auth admin plugin ──
  banned     Boolean?  @default(false)
  banReason  String?   @map("ban_reason") @db.VarChar(255)
  banExpires DateTime? @map("ban_expires")

  // ── Domain fields (declared to Better Auth as `additionalFields`) ──
  dob               DateTime? @db.Date
  gender            Gender?
  weight            Float?
  height            Float?
  congenitalDisease String?   @map("congenital_disease") @db.VarChar(255)
  /// Mapped to Better Auth's `image` field.
  avatar            String?   @db.VarChar(512)
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at")

  accounts         Account[]
  images           Image[]
  alerts           Alert[]
  caregiverLinks   CaregiverPatient[]     @relation("CaregiverUser")
  patientLinks     CaregiverPatient[]     @relation("PatientUser")
  readings         BloodPressureReading[]
  recordedReadings BloodPressureReading[] @relation("ReadingRecordedBy")
  posts            Post[]
  postComments     PostComment[]
  postCommentLikes PostCommentLike[]
  postLikes        PostLike[]
  sessions         UserSession[]
  passkeys         Passkey[]

  profileChanges   ProfileChangeLog[] @relation("ProfileChangeSubject")
  profileEditsMade ProfileChangeLog[] @relation("ProfileChangeActor")

  @@map("users")
}

/// One row per health field changed on a patient's profile.
///
/// Exists because `CaregiverPermission.full` lets somebody other than the
/// patient edit that patient's health information. An edit nobody can see is
/// indistinguishable from the patient misremembering their own weight, and
/// "who changed this to 80?" is the first question asked when a number looks
/// wrong.
///
/// **One row per field, not per request.** A request that changes weight and
/// height writes two rows. The question this table answers is "weight 60 →
/// 80, by whom, when" — a single row holding a JSON patch would force every
/// reader to diff it back apart, and would make a per-field query
/// (`where field = 'weight'`) a full scan instead of an index hit.
///
/// **Values are rendered text, not typed columns.** The five editable fields
/// span four types (Date, enum, Float, String), so typed storage means four
/// nullable column pairs of which three are always null. The audit's consumer
/// is a human reading a history list, and text is what they read. `null`
/// means the field genuinely had no value, which is why both sides are
/// nullable rather than defaulting to an empty string — "unset → 80" and
/// "'' → 80" are different events.
///
/// Rows are written only when the value actually changed; submitting the
/// current value again is not an edit and leaves no trace.
model ProfileChangeLog {
  id String @id @default(uuid()) @db.Uuid

  /// Whose record was changed. Always the patient, never the editor.
  patientId String @map("patient_id") @db.Uuid

  /// Who made the change. Equal to `patientId` when the patient edited their
  /// own record through this path.
  ///
  /// Nullable with `SetNull` rather than `Cascade`: deleting a caregiver's
  /// account must not erase the patient's record of what that caregiver did
  /// to them. `Restrict` was the other option and is worse — it would make a
  /// caregiver account undeletable for as long as any edit survives, which
  /// turns an audit row into a block on the right to erasure.
  actorId String? @map("actor_id") @db.Uuid

  /// The actor's display name as it was at the time of the edit.
  ///
  /// Denormalised on purpose, and not only to survive `actorId` going null:
  /// an audit entry should report who the actor *was* when they acted. A
  /// later rename must not silently rewrite history.
  actorName String @map("actor_name") @db.VarChar(201)

  /// Which field changed — one of the five editable health fields. A string
  /// rather than an enum: adding a field to the editable set should not
  /// require a migration, and an unrecognised value here is inert (it is
  /// displayed, never dispatched on).
  field String @db.VarChar(64)

  /// Rendered previous / new values. Null means the field held no value.
  oldValue String? @map("old_value") @db.VarChar(512)
  newValue String? @map("new_value") @db.VarChar(512)

  changedAt DateTime @default(now()) @map("changed_at")

  patient User  @relation("ProfileChangeSubject", fields: [patientId], references: [id], onDelete: Cascade)
  actor   User? @relation("ProfileChangeActor", fields: [actorId], references: [id], onDelete: SetNull)

  /// The patient's own trail, newest first — the only read path exposed.
  @@index([patientId, changedAt(sort: Desc)])
  @@map("profile_change_logs")
}

/// Better Auth's `passkey` model (from `@better-auth/passkey`).
///
/// One row per registered authenticator, not per user: the same account can
/// hold a phone's screen-lock credential and a hardware key, and revoking one
/// must not touch the other.
///
/// Field names are Better Auth's — the plugin addresses them through the
/// Prisma adapter, so renaming one here breaks the plugin even though
/// `@map` keeps the column snake_case like the rest of this schema.
model Passkey {
  id String @id @default(uuid()) @db.Uuid

  /// User-facing label, e.g. "Pixel 8". Nullable because the plugin allows
  /// registering without one; the client supplies a device name.
  name String? @db.VarChar(255)

  /// COSE public key, base64url. The only thing needed to verify an
  /// assertion — the private key never leaves the authenticator.
  publicKey String @map("public_key")

  userId String @map("user_id") @db.Uuid

  /// Authenticator-assigned credential id, base64url. Unique across all
  /// users: a credential identifies exactly one authenticator, and allowing
  /// a duplicate would let one device's assertion resolve to two accounts.
  credentialID String @unique @map("credential_id") @db.VarChar(255)

  /// Signature counter for clone detection. Some authenticators (Apple,
  /// Android platform keys) always report 0 — a stuck counter is not by
  /// itself proof of cloning.
  counter Int @default(0)

  /// 'singleDevice' | 'multiDevice' — whether the credential syncs across
  /// the user's devices via their password manager.
  deviceType String @map("device_type") @db.VarChar(32)

  /// True when the credential is backed up (synced passkey). A false value
  /// means losing the device loses the credential, which is why the UI
  /// warns before it is the account's only sign-in method.
  backedUp Boolean @default(false) @map("backed_up")

  /// Comma-separated AuthenticatorTransport list ('internal', 'hybrid', …).
  transports String? @db.VarChar(255)

  /// Authenticator model identifier. Kept for support triage only — it is
  /// not a trust signal here, since no attestation policy is enforced.
  aaguid String? @db.VarChar(64)

  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("passkeys")
}

/// Better Auth's `session` model, mapped onto the existing table.
///
/// Better Auth deletes a session on sign-out; this app flips `isActive`
/// instead so the login-sessions screen can show revoked devices as history.
/// `preserveSessionInDatabase` keeps that behaviour — see
/// docs/architecture/AUTH-better-auth-identity.md.
model UserSession {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  /// Opaque session token. Better Auth looks sessions up by this, not by id.
  token     String   @unique @db.VarChar(255)
  expiresAt DateTime @map("expires_at")
  ipAddress String?  @map("ip_address") @db.VarChar(45)
  userAgent String?  @map("user_agent") @db.VarChar(1024)

  /// Set by the admin plugin while an admin is impersonating this user.
  impersonatedBy String? @map("impersonated_by") @db.Uuid

  // ── Retained beyond Better Auth's schema, for the sessions screen ──
  deviceLabel  String?   @map("device_label") @db.VarChar(255)
  isActive     Boolean   @default(true) @map("is_active")
  revokedAt    DateTime? @map("revoked_at")
  lastActiveAt DateTime  @default(now()) @map("last_active_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])
  @@index([createdAt])
  @@map("user_sessions")
}

/// Better Auth's `account` model — one row per credential or social identity.
///
/// The password lives here under `providerId = 'credential'`, not on `users`.
/// A Google sign-in adds a second row for the same user.
model Account {
  id                    String    @id @default(uuid()) @db.Uuid
  /// Provider-side identifier: the user id for credentials, the subject claim for OAuth.
  accountId             String    @map("account_id") @db.VarChar(255)
  providerId            String    @map("provider_id") @db.VarChar(64)
  userId                String    @map("user_id") @db.Uuid
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?   @db.VarChar(512)
  /// bcrypt hash for `providerId = 'credential'`; null for social accounts.
  password              String?   @db.VarChar(255)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// One account per provider per user — this is what stops a second Google
  /// identity being linked into the same row.
  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

/// Better Auth's `verification` model — email OTPs and password-reset tokens.
/// Rows are short-lived; `expiresAt` is enforced by Better Auth, not the DB.
model Verification {
  id         String   @id @default(uuid()) @db.Uuid
  /// What is being verified: an email address, a phone number, a reset request.
  identifier String   @db.VarChar(255)
  value      String   @db.VarChar(255)
  expiresAt  DateTime @map("expires_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([identifier])
  @@index([expiresAt])
  @@map("verifications")
}

model CaregiverPatient {
  caregiverId  String              @map("caregiver_id") @db.Uuid
  patientId    String              @map("patient_id") @db.Uuid
  relationship RelationshipType
  status       CaregiverLinkStatus @default(pending)
  permission   CaregiverPermission @default(full)
  createdAt    DateTime            @default(now()) @map("created_at")
  respondedAt  DateTime?           @map("responded_at")

  caregiver User @relation("CaregiverUser", fields: [caregiverId], references: [id], onDelete: Cascade)
  patient   User @relation("PatientUser", fields: [patientId], references: [id], onDelete: Cascade)

  @@id([caregiverId, patientId])
  @@index([patientId])
  @@index([status])
  @@map("caregiver_patient")
}

model Image {
  id                Int      @id @default(autoincrement())
  userId            String   @map("user_id") @db.Uuid
  s3Key             String   @unique @map("s3_key") @db.VarChar(512)
  deviceName        String?  @map("device_name") @db.VarChar(255)
  imageQualityScore Float?   @map("image_quality_score")
  readingId         Int?     @unique @map("reading_id")
  uploadedAt        DateTime @default(now()) @map("uploaded_at")
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at")

  user    User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  reading BloodPressureReading? @relation(fields: [readingId], references: [id], onDelete: SetNull)

  @@index([userId, uploadedAt(sort: Desc)])
  @@map("images")
}

model Alert {
  id           Int        @id @default(autoincrement())
  userId       String     @map("user_id") @db.Uuid
  bpReadingId  Int        @map("bp_reading_id")
  alertMessage String     @map("alert_message") @db.VarChar(500)
  alertLevel   AlertLevel @map("alert_level")
  readAt       DateTime?  @map("read_at")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @default(now()) @updatedAt @map("updated_at")

  user    User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  reading BloodPressureReading @relation(fields: [bpReadingId], references: [id], onDelete: Cascade)

  /// One alert per recipient per reading.
  ///
  /// `ReadingService.createAlertForReading` fans an abnormal reading out to
  /// the patient's caregivers, so a retried or replayed creation could
  /// otherwise put the same alert in one person's bell twice. `createMany`
  /// passes `skipDuplicates`, which only means anything with this constraint
  /// behind it.
  @@unique([userId, bpReadingId])
  @@index([bpReadingId])
  @@index([userId, readAt, createdAt(sort: Desc)])
  @@map("alerts")
}

model BloodPressureReading {
  id       Int     @id @default(autoincrement())
  userId   String  @map("user_id") @db.Uuid
  clientId String? @unique @map("client_id") @db.VarChar(255)

  /// Who physically entered this reading. NULL = the patient themselves;
  /// otherwise the entering user's id (typically a linked caregiver).
  recordedById String?  @map("recorded_by_id") @db.Uuid
  systolic     Int
  diastolic    Int
  pulse        Int
  status       BpStatus
  measuredAt   DateTime @map("measured_at")
  notes        String?  @db.VarChar(500)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  // SetNull: deleting the recorder's account must not delete or block the
  // patient's reading — attribution degrades to the patient-default label.
  recordedBy User?   @relation("ReadingRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)
  images     Image[]
  alerts     Alert[]

  @@index([userId, measuredAt(sort: Desc)])
  @@map("blood_pressure_readings")
}

// ──────────────────────── New Models ────────────────────────

model Post {
  id        Int          @id @default(autoincrement())
  userId    String       @map("user_id") @db.Uuid
  clientId  String?      @unique @map("client_id") @db.VarChar(255)
  content   String       @db.Text
  category  PostCategory @default(general)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime?    @map("updated_at")

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  likes    PostLike[]
  comments PostComment[]

  @@index([userId, createdAt(sort: Desc)])
  @@index([category])
  @@map("posts")
}

model PostComment {
  id        Int       @id @default(autoincrement())
  postId    Int       @map("post_id")
  userId    String    @map("user_id") @db.Uuid
  parentId  Int?      @map("parent_id") // null = top-level comment
  content   String    @db.Text
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @map("updated_at")

  post    Post              @relation(fields: [postId], references: [id], onDelete: Cascade)
  user    User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent  PostComment?      @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies PostComment[]     @relation("CommentReplies")
  likes   PostCommentLike[]

  @@index([postId, createdAt])
  @@index([userId])
  @@index([parentId])
  @@map("post_comments")
}

model PostCommentLike {
  userId    String   @map("user_id") @db.Uuid
  commentId Int      @map("comment_id")
  createdAt DateTime @default(now()) @map("created_at")

  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  comment PostComment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@id([userId, commentId])
  @@map("post_comment_likes")
}

model PostLike {
  userId    String   @map("user_id") @db.Uuid
  postId    Int      @map("post_id")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([userId, postId])
  @@map("post_likes")
}
