# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# Tamagui compiler cache
.tamagui/

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

.env
# local env files
.env*.local

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android

/coverage

# Native module build output — Gradle regenerates it from android/src and
# build.gradle. It was tracked by accident (a git add -A during an icon change)
# and carried 177 files of .dex/.jar/.bin, churning on every local build.
modules/*/android/build/
modules/*/android/.cxx/
