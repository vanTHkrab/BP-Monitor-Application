  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint --max-warnings 0",
    "sync-yolo-model": "node ./scripts/sync-yolo-model.mjs",
    "verify-models": "node ./scripts/verify-models.mjs",
    "prestart": "node ./scripts/verify-models.mjs",
    "preandroid": "node ./scripts/verify-models.mjs",
    "preios": "node ./scripts/verify-models.mjs",
    "typecheck": "tsc --noEmit -p .",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "test": "jest --watchman=false",
    "test:watch": "jest --watch --coverage=false --changedSince=origin/main",
    "test:debug": "jest -o --watch --coverage=false",
    "test:update": "jest -u --coverage=false"
  },
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/.expo/",
      "/dist/",
      "/android/",
      "/e2e/"
    ],
    "collectCoverage": true,
    "collectCoverageFrom": [
      "**/*.{ts,tsx,js,jsx}",
      "!**/coverage/**",
      "!**/node_modules/**",
      "!**/dist/**",
      "!**/android/**",
      "!**/drizzle/**",
      "!**/*.config.{js,ts}",
      "!**/expo-env.d.ts",
      "!**/.expo/**"
    ]
  },
  "private": true
}
