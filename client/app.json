{
  "expo": {
    "name": "BP Mobile",
    "slug": "bp-mobile-application",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "bpmobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.project.bpmonitor"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#BFE8F0",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.project.bpmonitor",
      "versionCode": 1,
      "permissions": ["android.permission.CAMERA"]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#BFE8F0",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 92
        }
      ],
      [
        "expo-sqlite",
        {
          "enableFTS": false,
          "useSQLCipher": false,
          "ios": {
            "customBuildFlags": [
              "-DSQLITE_ENABLE_DBSTAT_VTAB=1 -DSQLITE_ENABLE_SNAPSHOT=1"
            ]
          }
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-secure-store",
      "expo-sharing",
      "@react-native-google-signin/google-signin",
      [
        "expo-camera",
        {
          "cameraPermission": "ใช้กล้องเพื่อถ่ายภาพหน้าจอเครื่องวัดความดัน"
        }
      ],
      "./modules/bp-vision/plugin/withBpVisionModels",
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/sounds/bp_voice_1.wav",
            "./assets/sounds/bp_voice_2.wav",
            "./assets/sounds/bp_voice_3.wav",
            "./assets/sounds/bp_voice_4.wav",
            "./assets/sounds/bp_voice_5.wav"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b5572b71-c303-4b8e-b89e-14007c46ca3c"
      }
    },
    "owner": "bp-monitor-education-project"
  }
}
