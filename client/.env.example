# Full GraphQL endpoint of the NestJS API gateway, INCLUDING the /graphql path.
# - When unset in Expo Go, the app falls back to the LAN host the bundler is
#   served from + ":3000/graphql".
# - In a release/EAS build there is no Expo host, so this MUST be set.
#
# Examples:
#   EXPO_PUBLIC_API_URL=http://192.168.1.10:3000/graphql   # local LAN dev
#   EXPO_PUBLIC_API_URL=http://10.0.2.2:3000/graphql       # Android emulator → host
#   EXPO_PUBLIC_API_URL=https://api.example.com/graphql    # production
EXPO_PUBLIC_API_URL=

# Google sign-in on the login screen (optional — the button is hidden when
# unset, rather than shown and failing on tap).
#
# This is the **web** client ID, even though the app is Android. Credential
# Manager mints an ID token whose audience is the web client; the Android
# client ID exists only to tie the request to the app's signing certificate,
# and it is configured on the gateway as GOOGLE_ANDROID_CLIENT_ID. Putting
# the Android ID here produces a token the gateway rejects.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=